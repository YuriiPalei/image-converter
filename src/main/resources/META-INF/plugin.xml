<idea-plugin>
    <id>palei.yurii.image-converter</id>
    <name>Image to WebP Converter</name>
    <vendor email="poley.yuri@gmail.com">Yurii Palei</vendor>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

    </extensions>

    <actions>
        <action id="ConvertToWebPAction" class="palei.yurii.imageconverter.actions.ConvertToWebPAction"
                text="Convert to WebP"
                description="Converts images to WebP format">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="OpenFile"/>
        </action>
    </actions>
</idea-plugin>